{
  "name": "umldiagram",
  "displayName": "bigUML Modeling Tool",
  "version": "0.6.4",
  "description": "Graphical UML Editor",
  "categories": [
    "Education",
    "Programming Languages",
    "Visualization"
  ],
  "keywords": [
    "Modeling Tool",
    "UML",
    "UML Diagram",
    "Unified Modeling Language"
  ],
  "homepage": "https://github.com/borkdominik/bigUML",
  "bugs": "https://github.com/borkdominik/bigUML/issues",
  "license": "MIT",
  "author": {
    "name": "Business Informatics Group (TU Wien)"
  },
  "contributors": [
    {
      "name": "Business Informatics Group (TU Wien)",
      "email": "dominik.bork@tuwien.ac.at",
      "url": "https://me.big.tuwien.ac.at/"
    },
    {
      "name": "Haydar Metin",
      "email": "dev@haydar.metin.at",
      "url": "https://me.big.tuwien.ac.at/"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/borkdominik/bigUML"
  },
  "publisher": "BIGModelingTools",
  "files": [
    "build",
    "webviews",
    "templates",
    "resources",
    "LICENSE",
    "README.md",
    "syntaxes",
    "language-configuration.json"
  ],
  "type": "module",
  "main": "./build/index.cjs",
  "scripts": {
    "build": "tsx esbuild.ts",
    "build:analyze": "tsx esbuild.ts --production --analyze",
    "build:prod": "tsx esbuild.ts --production",
    "vscode:package": "vsce package --no-dependencies",
    "vscode:package-pre": "pnpm vscode:package --pre-release",
    "vscode:prepublish": "pnpm build:prod",
    "vscode:release": "vsce publish --no-dependencies",
    "vscode:release-pre": "pnpm vscode:release --pre-release",
    "watch": "tsx esbuild.ts --watch"
  },
  "dependencies": {
    "@borkdominik-biguml/big-advancedsearch": "workspace:*",
    "@borkdominik-biguml/big-code-generation": "workspace:*",
    "@borkdominik-biguml/big-minimap": "workspace:*",
    "@borkdominik-biguml/big-outline": "workspace:*",
    "@borkdominik-biguml/big-property-palette": "workspace:*",
    "@borkdominik-biguml/big-revision-management": "workspace:*",
    "@borkdominik-biguml/big-vscode": "workspace:*",
    "@borkdominik-biguml/uml-glsp-client": "workspace:*",
    "@borkdominik-biguml/uml-glsp-server": "workspace:*",
    "@borkdominik-biguml/uml-model-server": "workspace:*",
    "@vscode/codicons": "catalog:",
    "inversify": "catalog:",
    "langium": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "vscode-languageclient": "catalog:",
    "vscode-languageserver": "catalog:"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/vscode": "catalog:",
    "@vscode/vsce": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:"
  },
  "contributes": {
    "commands": [
      {
        "command": "bigUML.model.newEmpty",
        "title": "New Empty UML Diagram",
        "category": "bigUML",
        "enablement": "workspaceFolderCount > 0"
      },
      {
        "command": "bigUML.exportAsSVG",
        "title": "Export as SVG",
        "category": "bigUML",
        "enablement": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "command": "bigUML.fit",
        "title": "Fit to Screen",
        "category": "bigUML",
        "enablement": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "command": "bigUML.center",
        "title": "Center selection",
        "category": "bigUML",
        "enablement": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "command": "bigUML.show.umlPanel",
        "title": "Show UML panel",
        "category": "bigUML",
        "enablement": "activeCustomEditorId == 'bigUML.diagramView'",
        "icon": "$(symbol-reference)"
      },
      {
        "command": "timeline.import",
        "title": "Import Timeline",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "timeline.export",
        "title": "Export Timeline",
        "icon": "$(cloud-download)"
      },
      {
        "command": "bigUML.advancedsearch.toggleSyntax",
        "title": "Syntax help",
        "category": "bigUML",
        "icon": "$(question)"
      },
      {
        "command": "bigUML.advancedsearch.enablePreviews",
        "title": "Show all previews",
        "category": "bigUML",
        "icon": "$(eye-closed)"
      },
      {
        "command": "bigUML.advancedsearch.disablePreviews",
        "title": "Hide all previews",
        "category": "bigUML",
        "icon": "$(eye)"
      }
    ],
    "configuration": {
      "title": "bigUML",
      "properties": {
        "bigUML.timeline.onSave": {
          "type": "boolean",
          "default": false,
          "description": "Create a new timeline entry on file save."
        },
        "bigUML.timeline.persistent": {
          "type": "boolean",
          "default": false,
          "description": "Persist timeline entries across restarts."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "bigUML.diagramView",
        "displayName": "bigUML Editor",
        "selector": [
          {
            "filenamePattern": "*.uml"
          }
        ]
      }
    ],
    "grammars": [
      {
        "language": "uml-diagram",
        "scopeName": "source.uml-diagram",
        "path": "./syntaxes/uml-diagram.tmLanguage.json"
      }
    ],
    "keybindings": [
      {
        "key": "alt+f",
        "mac": "alt+f",
        "command": "bigUML.fit",
        "when": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "key": "alt+c",
        "mac": "alt+c",
        "command": "bigUML.center",
        "when": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "key": "ctrl+a",
        "mac": "ctrl+a",
        "command": "bigUML.selectAll",
        "when": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "key": "alt+a",
        "mac": "alt+a",
        "command": "bigUML.editor.activateResizeMode",
        "when": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "key": "ctrl+f",
        "mac": "ctrl+f",
        "command": "bigUML.editor.showSearch",
        "when": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "key": "alt+p",
        "mac": "alt+p",
        "command": "bigUML.editor.focusToolPalette",
        "when": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "key": "alt+g",
        "mac": "alt+g",
        "command": "bigUML.editor.focusDiagram",
        "when": "activeCustomEditorId == 'bigUML.diagramView'"
      },
      {
        "key": "n",
        "mac": "n",
        "command": "bigUML.editor.enablePrimaryElementNavigator",
        "when": "activeCustomEditorId == 'bigUML.diagramView' && bigUML.editorSelectedElementsAmount == 1"
      },
      {
        "key": "alt+n",
        "mac": "alt+n",
        "command": "bigUML.editor.enableSecondaryElementNavigator",
        "when": "activeCustomEditorId == 'bigUML.diagramView' && bigUML.editorSelectedElementsAmount == 1"
      }
    ],
    "languages": [
      {
        "id": "uml-diagram",
        "aliases": [
          "UML Diagram",
          "uml-diagram"
        ],
        "icon": {
          "light": "./resources/file_icons/light/uml.svg",
          "dark": "./resources/file_icons/dark/uml.svg"
        },
        "extensions": [
          ".uml"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "timeline.import",
          "when": "false"
        },
        {
          "command": "timeline.export",
          "when": "false"
        },
        {
          "command": "bigUML.advancedsearch.toggleSyntax",
          "when": "false"
        },
        {
          "command": "bigUML.advancedsearch.enablePreviews",
          "when": "false"
        },
        {
          "command": "bigUML.advancedsearch.disablePreviews",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "timeline.import",
          "when": "view == bigUML.panel.revision-management",
          "group": "navigation"
        },
        {
          "command": "timeline.export",
          "when": "view == bigUML.panel.revision-management",
          "group": "navigation"
        },
        {
          "command": "bigUML.advancedsearch.toggleSyntax",
          "when": "view == bigUML.panel.advancedsearch",
          "group": "navigation@1"
        },
        {
          "command": "bigUML.advancedsearch.enablePreviews",
          "when": "view == bigUML.panel.advancedsearch && !bigUML.advancedsearch.previewsOn",
          "group": "navigation@2"
        },
        {
          "command": "bigUML.advancedsearch.disablePreviews",
          "when": "view == bigUML.panel.advancedsearch && bigUML.advancedsearch.previewsOn",
          "group": "navigation@2"
        }
      ],
      "webview/context": [],
      "file/newFile": [
        {
          "command": "bigUML.model.newEmpty",
          "when": "workspaceFolderCount > 0"
        }
      ],
      "editor/title": [
        {
          "command": "bigUML.show.umlPanel",
          "when": "activeCustomEditorId == 'bigUML.diagramView'",
          "group": "navigation"
        },
        {
          "submenu": "bigUML.editor.title",
          "group": "bookmarks"
        }
      ],
      "bigUML.editor.title": [
        {
          "command": "bigUML.fit",
          "group": "navigation",
          "when": "activeCustomEditorId == 'bigUML.diagramView'"
        },
        {
          "command": "bigUML.center",
          "group": "navigation",
          "when": "activeCustomEditorId == 'bigUML.diagramView'"
        },
        {
          "command": "bigUML.exportAsSVG",
          "group": "navigation",
          "when": "activeCustomEditorId == 'bigUML.diagramView'"
        }
      ]
    },
    "submenus": [
      {
        "id": "bigUML.editor.title",
        "label": "Diagram"
      }
    ],
    "views": {
      "bigUML-panel": [
        {
          "id": "bigUML.panel.property-palette",
          "name": "Properties",
          "type": "webview",
          "when": "bigUML.isRunning"
        },
        {
          "id": "bigUML.panel.minimap",
          "name": "Minimap",
          "type": "webview",
          "when": "bigUML.isRunning"
        },
        {
          "id": "bigUML.panel.outline",
          "name": "Diagram Outline",
          "type": "tree",
          "visibility": "collapsed",
          "when": "bigUML.isRunning"
        },
        {
          "id": "bigUML.panel.code-generation",
          "name": "Code Generation",
          "type": "webview",
          "when": "false"
        },
        {
          "id": "bigUML.panel.advancedsearch",
          "name": "Advanced Search",
          "type": "webview",
          "when": "false"
        },
        {
          "id": "bigUML.panel.revision-management",
          "name": "Timeline",
          "type": "webview",
          "when": "false"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "bigUML-panel",
          "icon": "./resources/file_icons/dark/uml.svg",
          "title": "UML"
        }
      ]
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "icon": "./resources/logo.png",
  "galleryBanner": {
    "color": "#1d1d1d",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.63.0"
  }
}
