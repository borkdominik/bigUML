{
  "name": "uml-diagram",
  "scopeName": "source.uml-diagram",
  "fileTypes": [
    ".uml"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "name": "keyword.control.uml-diagram",
      "match": "\\b(ACTIVITY|CLASS|COMMUNICATION|COMPOSITE|CONCURRENT|CREATE|CROSS|DASHED|DELETE|DEPLOYMENT|DIAMOND|DOTTED|EAST|EXTERNAL|FILLED_DIAMOND|FILLED_TRIANGLE|GUARDED|HORIZONTAL|IN|INFORMATION_FLOW|INOUT|INTERNAL|LOCAL|NONE|NORTH|OPEN_ARROW|OUT|PACKAGE|PRIVATE|PROTECTED|PUBLIC|READ|RETURN|SEQUENTIAL|SHARED|SOLID|SOUTH|STATE_MACHINE|TRIANGLE|UPDATE|USE_CASE|VERTICAL|WEST|null)\\b|\\B(\"Abstraction\"|\"AcceptEventAction\"|\"Activity\"|\"ActivityDiagram\"|\"ActivityFinalNode\"|\"ActivityParameterNode\"|\"ActivityPartition\"|\"Actor\"|\"Artifact\"|\"Association\"|\"Bounds\"|\"CentralBufferNode\"|\"Choice\"|\"Class\"|\"ClassDiagram\"|\"Classifier\"|\"CommunicationDiagram\"|\"CommunicationPath\"|\"ControlFlow\"|\"DataType\"|\"DecisionNode\"|\"DeepHistory\"|\"Dependency\"|\"Deployment\"|\"DeploymentDiagram\"|\"DeploymentModel\"|\"DeploymentNode\"|\"DeploymentPackage\"|\"DeploymentSpecification\"|\"Device\"|\"Edge\"|\"EdgeAnchor\"|\"ElementImport\"|\"EntryPoint\"|\"Enumeration\"|\"EnumerationLiteral\"|\"ExecutionEnvironment\"|\"ExitPoint\"|\"Extend\"|\"FinalState\"|\"FlowFinalNode\"|\"Fork\"|\"ForkNode\"|\"Generalization\"|\"GenericEdge\"|\"Include\"|\"InformationFlow\"|\"InformationFlowDiagram\"|\"InitialNode\"|\"InitialState\"|\"InputPin\"|\"InstanceSpecification\"|\"Interaction\"|\"Interface\"|\"InterfaceRealization\"|\"Join\"|\"JoinNode\"|\"Lifeline\"|\"LiteralSpecification\"|\"Manifestation\"|\"MergeNode\"|\"Message\"|\"NaryAssociation\"|\"Node\"|\"Note\"|\"OpaqueAction\"|\"Operation\"|\"OutputPin\"|\"Package\"|\"PackageDiagram\"|\"PackageImport\"|\"PackageMerge\"|\"Parameter\"|\"Point\"|\"PrimitiveType\"|\"Property\"|\"Realization\"|\"Reference\"|\"Region\"|\"SendSignalAction\"|\"ShallowHistory\"|\"Slot\"|\"SlotDefiningFeature\"|\"State\"|\"StateMachine\"|\"StateMachineDiagram\"|\"StatePart\"|\"Subject\"|\"Substitution\"|\"Terminate\"|\"TextLabel\"|\"Transition\"|\"UnionType_0\"|\"UnionType_1\"|\"Usage\"|\"UseCase\"|\"UseCaseDiagram\"|\"__id\"|\"__refType\"|\"__type\"|\"__value\"|\"aggregation\"|\"alias\"|\"artifacts\"|\"body\"|\"bounds\"|\"concurrency\"|\"definingFeature\"|\"deploymentSpecifications\"|\"devices\"|\"diagram\"|\"diagramType\"|\"direction\"|\"edge\"|\"effect\"|\"entities\"|\"executionEnvironments\"|\"guard\"|\"height\"|\"inputPins\"|\"isAbstract\"|\"isActive\"|\"isDerived\"|\"isDerivedUnion\"|\"isException\"|\"isNavigable\"|\"isOrdered\"|\"isQuery\"|\"isReadOnly\"|\"isStatic\"|\"isStream\"|\"isSubstitutable\"|\"isUnique\"|\"kind\"|\"lifelines\"|\"lineStyle\"|\"messages\"|\"modifiers\"|\"multiplicity\"|\"name\"|\"nestedArtifacts\"|\"nestedEnvironments\"|\"nestedNodes\"|\"nodes\"|\"operations\"|\"orientation\"|\"outputPins\"|\"parameterType\"|\"parameterTypeRef\"|\"parameters\"|\"parts\"|\"partsHeight\"|\"properties\"|\"propertyType\"|\"propertyTypeRef\"|\"regionHeight\"|\"regions\"|\"relations\"|\"routingPoints\"|\"slots\"|\"source\"|\"sourceAggregation\"|\"sourceMarker\"|\"sourceModifiers\"|\"sourceMultiplicity\"|\"sourceName\"|\"sourcePoint\"|\"subpartitions\"|\"subvertices\"|\"target\"|\"targetAggregation\"|\"targetMarker\"|\"targetModifiers\"|\"targetMultiplicity\"|\"targetName\"|\"targetPoint\"|\"transitions\"|\"trigger\"|\"uri\"|\"useCases\"|\"value\"|\"values\"|\"visibility\"|\"weight\"|\"width\"|\"x\"|\"y\")\\B"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.uml-diagram",
          "begin": "/\\*",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.uml-diagram"
            }
          },
          "end": "\\*/",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.uml-diagram"
            }
          }
        },
        {
          "begin": "//",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.comment.leading.uml-diagram"
            }
          },
          "end": "(?=$)",
          "name": "comment.line.uml-diagram"
        }
      ]
    }
  }
}
