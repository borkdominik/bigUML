{
  "name": "client",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -C application/vscode run build",
    "check": "pnpm -s typecheck && pnpm -s lint && pnpm -s knip",
    "check:watch": "nodemon --config configs/nodemon/nodemon.json",
    "clean": "rimraf application/vscode/build application/vscode/webviews node_modules/.cache",
    "dev": "concurrently -k -n esbuild,check,generate -c blue,magenta,green \"pnpm -C application/vscode run watch\" \"pnpm check:watch\" \"pnpm generate:watch\"",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "generate": "pnpm -r --filter \"./packages/*\" run generate",
    "generate:watch": "nodemon --config configs/nodemon/generate.json",
    "hooks:install": "lefthook install",
    "hooks:uninstall": "lefthook uninstall",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "package": "pnpm -C application/vscode run vscode:package && mv application/vscode/*.vsix release/vsix",
    "package:zip": "pnpm package && zip -r ./release-$(date +%Y%m%d-%H%M).zip ./release",
    "setup": "pnpm install && pnpm build",
    "test": "pnpm -r test",
    "typecheck": "tsc -p configs/ts/node.project.json && tsc -p configs/ts/browser.project.json",
    "watch": "pnpm dev"
  },
  "devDependencies": {
    "@types/lodash": "catalog:",
    "@types/node": "catalog:",
    "concurrently": "^9.1.2",
    "knip": "^6.38.0",
    "lefthook": "^2.1.14",
    "nodemon": "^3.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "rimraf": "^6.0.1",
    "tsx": "catalog:",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.14.0"
  },
  "packageManager": "pnpm@11.25.0"
}
