  "repository": {
    "type": "git",
    "url": "https://github.com/borkdominik/bigUML.git"
  },
  "type": "module",
  "exports": {
    ".": "./src/env/common/index.ts",
    "./vscode": "./src/env/vscode/index.ts",
    "./jsx": "./src/env/jsx/index.ts",
    "./jsx/jsx-runtime": "./src/env/jsx/jsx-runtime.ts",
    "./jsx/jsx-dev-runtime": "./src/env/jsx/jsx-dev-runtime.ts",
    "./generator": "./generator/index.ts",
    "./gen/common": "./src/gen/common/index.ts",
    "./gen/vscode": "./src/gen/vscode/index.ts"
  },
  "scripts": {
    "generate": "rimraf src/gen && pnpm run language:generate",
    "language:generate": "uml-language-tooling extension generate -d ../../tooling/uml-language/src/language/def.ts -g ./generator/index.ts"
  },
  "dependencies": {
    "@borkdominik-biguml/big-common": "workspace:*",
    "@borkdominik-biguml/uml-language-tooling": "workspace:*",
    "@borkdominik-biguml/uml-model-server": "workspace:*",
    "@eclipse-glsp/layout-elk": "catalog:",
    "@eclipse-glsp/protocol": "catalog:",
    "@eclipse-glsp/server": "catalog:",
    "eta": "catalog:",
    "fast-json-patch": "catalog:",
    "langium": "catalog:",
    "reflect-metadata": "catalog:",
    "uuid": "catalog:",
    "vscode-uri": "catalog:"
  },
  "peerDependencies": {
    "inversify": "catalog:"
  }
}
